PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated browser origins. FRONTEND_ORIGIN is used when this is empty.
# Production should list the live brand origins, not "*".
# Example: https://productreviews.com.au,https://www.productreviews.com.au
FRONTEND_ORIGINS=http://localhost:3000
NODE_ENV=development
BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=45000

# mock | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1200

# mock | openai — openai reuses AI_API_KEY server-side (no duplicate key)
SEARCH_PROVIDER=mock
SEARCH_MODEL=
SEARCH_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=5
SEARCH_CONTEXT_SIZE=medium

# Anonymous conversation logging (not user memory). Frontend never uses these.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://ava:ava@127.0.0.1:5432/productreviews
DATABASE_POOL_MAX=10

# Rate limiting (conversation POST only; health is never limited)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# Use X-Forwarded-Host only behind a trusted reverse proxy. Leave false for
# direct local requests so clients cannot spoof the brand host.
TRUST_FORWARDED_HOST=false

# Development/test only. Unknown production hosts never use this fallback.
DEFAULT_DEV_BRAND=productreviews

# Reject rather than queue when these in-flight provider calls are already running
AI_MAX_CONCURRENT_REQUESTS=4
SEARCH_MAX_CONCURRENT_REQUESTS=4

# Retention is a client policy decision. Leave empty until approved.
# Automatic deletion is NOT enabled by setting a number here.
CONVERSATION_RETENTION_DAYS=
CONVERSATION_RETENTION_APPROVED=false
