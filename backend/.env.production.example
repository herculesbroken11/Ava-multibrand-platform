# ProductReviews.com.au — backend production environment template
# Copy to backend/.env.production on the server. Never commit real secrets.

# --- Deployment / proxy ---
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=45000

# Leave both false unless a trusted reverse proxy overwrites forwarded headers.
TRUST_PROXY=false
TRUST_FORWARDED_HOST=false

# Development hostname fallback only. Unknown production hosts never use this.
DEFAULT_DEV_BRAND=productreviews

# --- Frontend origins (CORS) ---
FRONTEND_ORIGIN=https://productreviews.com.au
FRONTEND_ORIGINS=https://productreviews.com.au,https://www.productreviews.com.au

# --- Backend secrets: client-owned AI (never NEXT_PUBLIC_, never commit the key) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CONCURRENT_REQUESTS=4

# --- Search (reuses AI_API_KEY server-side) ---
SEARCH_PROVIDER=openai
SEARCH_MODEL=
SEARCH_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=5
SEARCH_CONTEXT_SIZE=medium
SEARCH_MAX_CONCURRENT_REQUESTS=4

# --- Database (anonymous conversation logging; frontend never connects) ---
DATABASE_ENABLED=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/productreviews
DATABASE_POOL_MAX=10

# Retention is unresolved until the client approves a period.
# Setting a number here does not turn on automatic deletion.
CONVERSATION_RETENTION_DAYS=
CONVERSATION_RETENTION_APPROVED=false

# --- Rate limiting (conversation POST; health is never limited) ---
# Defaults are not a final capacity plan.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
