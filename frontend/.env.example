NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Development/test only. localhost and 127.0.0.1 resolve this registered brand.
# Unknown production hosts never fall back to ProductReviews.
DEFAULT_DEV_BRAND=productreviews

# Use X-Forwarded-Host only behind a trusted reverse proxy. Leave false locally.
TRUST_FORWARDED_HOST=false

# GA4 / GTM stay off until the site owner has notice/consent in place.
# Do not put conversation text, secrets, or production IDs in committed files.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Production must use HTTPS, never http://localhost:4000.
# Leave this as localhost for local development only.
# NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PRODUCTION_API_ORIGIN
