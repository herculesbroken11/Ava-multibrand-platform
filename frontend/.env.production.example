# ProductReviews.com.au — frontend public production values
# Copy to frontend/.env.production on the host. These values are visible in the browser bundle.
# Do not put API keys, DATABASE_URL, or conversation text here.

# Final API hostname is pending hosting/domain architecture. Do not use localhost.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PRODUCTION_API_ORIGIN

# Development hostname fallback only. Unknown production hosts never use this.
DEFAULT_DEV_BRAND=productreviews

# Leave false unless a trusted reverse proxy overwrites X-Forwarded-Host.
TRUST_FORWARDED_HOST=false

# Analytics stays off until the client supplies a property/ID and confirms
# Privacy Policy / notice / any required consent for the launch context.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
